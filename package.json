{
  "name": "deep-dive",
  "private": true,
  "version": "0.1.0",
  "description": "브라우저에서 바로 실행되는 세션형(7~10분) 로우폴리 3D 잠수함 서바이벌 액션 — 버티컬 슬라이스",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:size": "node scripts/check-build-size.mjs",
    "status": "node scripts/print-project-status.mjs",
    "check:scope": "node scripts/check-scope-guard.mjs",
    "verify:tooling": "node src/tools/__verification__/run.mjs",
    "verify:gameplay": "node src/systems/__verification__/run.mjs",
    "verify:hud": "node scripts/verify-hud.mjs",
    "verify:meta": "node src/meta/__verification__/run.mjs",
    "verify:sprint-a": "node scripts/verify-sprint-a.mjs",
    "verify:sprint-b": "node scripts/verify-sprint-b.mjs",
    "verify:sprint-c": "node scripts/verify-sprint-c.mjs",
    "verify:runtime-closure": "node scripts/verify-runtime-closure.mjs",
    "verify:closure-browser": "node scripts/runtime-closure-browser.mjs",
    "evidence:ec12": "node scripts/evidence-ec12-debrief.mjs",
    "evidence:boss": "node scripts/evidence-boss-closure.mjs",
    "evidence:ec12-locked": "node scripts/evidence-ec12-locked-terminal.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
